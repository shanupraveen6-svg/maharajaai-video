rules_version = '2';
// TryFocus reads and writes Firestore only from its server (Firebase Admin), which bypasses these rules.
// No browser or phone ever talks to Firestore directly, so every direct request is refused.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
