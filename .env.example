# Every setting TryFocus reads. Copy to .env.local for local work; set the same keys in Vercel
# (Project → Settings → Environment Variables) for production. Never commit real values.

# --- Firebase (server only; the app never uses the browser Firebase SDK) ---
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
# Paste the key with literal \n line breaks.
FIREBASE_PRIVATE_KEY=
FIREBASE_STORAGE_BUCKET=

# --- Sign-in and secrets (use long random strings) ---
OPERATOR_AUTH_SECRET=
# TryFocus admin login.
OPERATOR_USERNAME=
OPERATOR_PASSWORD=
# Vercel cron (daily privacy cleanup) sends this; the cleanup refuses to run without it.
CRON_SECRET=
# Optional: signs fal.ai webhooks; falls back to OPERATOR_AUTH_SECRET.
FAL_WEBHOOK_SECRET=

# --- AI providers ---
FAL_KEY=
GEMINI_API_KEY=
GOOGLE_AI_API_KEY_PRIMARY=
GENLOOK_API_KEY=
# Optional FASHN Try-On engine (used only when set).
FASHN_API_KEY=
# Engine order (see try-on-provider.ts and video-engines.ts). Empty = the defaults below.
# Try-On: genlook,fal,fashn,gemini (Gemini always stays the last backup)
TRYON_ENGINE_ORDER=
# AI Video: h3-max,gemini-omni (pixverse-c1 and vidu-q4 can be added after testing; an engine resting after 3 failures in 10 min is skipped)
VIDEO_ENGINE_ORDER=
# Optional model overrides.
GEMINI_IMAGE_MODEL=
GEMINI_ANALYSIS_MODEL=
GEMINI_OCR_MODEL=

# --- AI cost estimates (US dollars per call) and daily spending caps (see usage-ledger.ts) ---
# Set from your fal.ai and Google invoices. Caps: empty or 0 = no cap.
AI_COST_TRY_ON_USD=0.068
AI_COST_VIDEO_PORTRAIT_USD=0.0735
AI_COST_VIDEO_RENDER_USD=0.48
AI_COST_LIVE_SESSION_USD=0.6
USD_TO_INR=98
AI_DAILY_CAP_CLIENT_USD=
AI_DAILY_CAP_PLATFORM_USD=

# --- WhatsApp Cloud API (optional; QR delivery works without it) ---
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_TEMPLATE_NAME=
WHATSAPP_TEMPLATE_LANGUAGE=
WHATSAPP_GRAPH_API_VERSION=

# --- Store rules and pages ---
NEXT_PUBLIC_PRIVACY_EMAIL=
# Optional: Maharaja's legacy workspace code and price tiers.
MAHARAJA_WORKSPACE_CODE=
MAHARAJA_LUXURY_TIER_MIN=
MAHARAJA_FESTIVE_TIER_MIN=
# "false" turns off per-customer repeat limits (testing only).
ENFORCE_REPEAT_LIMITS=

# --- Local development only: run without Firebase (never set in production) ---
ALLOW_MOCK_BACKEND=
